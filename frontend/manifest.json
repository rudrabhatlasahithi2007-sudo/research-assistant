
{
    "manifest_version": 3,
    "name": "Research Assistant",
    "version": "1.0.0",
    "description": "AI-powered research summarization, research gap analysis, and active recall quizzes.",

    "permissions": [
        "activeTab",
        "storage",
        "sidePanel",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://localhost:8081/*"
    ],

    "icons": {
        "16": "AI Study Assistant Icon.png",
        "48": "AI Study Assistant Icon.png",
        "128": "AI Study Assistant Icon.png"
    },

    "action": {
        "default_title": "Research Assistant",
        "default_icon": {
            "16": "AI Study Assistant Icon.png",
            "48": "AI Study Assistant Icon.png",
            "128": "AI Study Assistant Icon.png"
        }
    },

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
